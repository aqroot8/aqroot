# PlatformIO / ESP-IDF build artifacts
.pio/
build/
*.o
*.bin

# Editor / IDE
.vscode/

# VS Code "Local History" extension snapshots. These are editor-local undo
# history (each directory carries its own nested .git), not project sources --
# every snapshot shadows a file that is already tracked here.
.history/

# KiCad temporary / local-state files
# (project, schematic, PCB, symbol, footprint, worksheet and library-table
#  files are intentionally NOT ignored -- they are the canonical sources)
*.kicad_prl
*.kicad_pro-bak
*.kicad_sch-bak
*.kicad_pcb-bak
_autosave-*
~*.lck

# Locally generated snapshot archives of the Beta KiCad project. Fully anchored
# to these exact paths on purpose -- a bare *.zip would also hide legitimate
# release packages, which we do want tracked.
/hardware/beta/kicad/aqroot-beta.zip
/hardware/beta/kicad.zip

# Python bytecode from the hardware check scripts
__pycache__/
*.pyc

# Router scratch workspace.  route_battery_block.py builds project-faithful
# copies of the whole KiCad project here to route and DRC against; it is
# regenerated on every run and must never be committed.
hardware/beta-v2/checks/w/
hardware/beta-v2/checks/__pycache__/

# prefix_002w.py's AQROOT_PROBE_OUT dump.  It is the pinned regression's raw
# per-run probe output, regenerated (deterministically) on every validate run.
# The blessed prefix_002w_manifest.json is the evidence of record; this file is
# not required and must never be committed.
hardware/beta-v2/checks/probe_002w_prefix.json
