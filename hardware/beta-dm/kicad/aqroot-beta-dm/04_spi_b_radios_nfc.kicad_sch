	(text "CC1101 FUNCTIONAL PLACEHOLDER\n\nMODULE LOCKED: EBYTE E07-400M10S\nNOT A BARE IC - MATCHING / FILTERING ON MODULE\nANTENNA: MODULE IPEX (TAOGLAS FXP450)\nGDO2 INTENTIONALLY OMITTED\n\nCS HAS 10k HARDWARE PULL-UP TO +3V3\n\nNO FOOTPRINT\nDO NOT ROUTE"
		(exclude_from_sim no)
		(at 88.646 101.854 0)
		(effects
