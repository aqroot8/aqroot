		(property "BOM_Class" "STANDARD_EIA_PASSIVE - multi-source, approved alternates, no premium single MPN"
			(at 175.26 92.71 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "IR LED current limit on the +3V3 IR branch. Rail 3.3 V, TSAL6200 Vf ~1.35 V typ / ~1.6 V high, AO3400A drop negligible at this current, so I = (3.3 - Vf) / 18R gives ~108 mA at Vf 1.35 V and ~94 mA at Vf 1.6 V, target ~100 mA. Peak dissipation in R24 is I^2*R, about 0.21 W at 108 mA and 0.18 W at 100 mA; the drive is 38 kHz pulsed at low duty so average power is far below that, and 0805 is chosen for pulse-energy headroom rather than average power. Do NOT raise IR current - longer-range IR tuning is deferred post-Kickstarter."
			(at 175.26 92.71 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
