		(property "Description" "Low-voltage 16-bit I2C-bus I/O port with interrupt and Agile I/O, TSSOP-24"
			(at 82.55 74.93 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
