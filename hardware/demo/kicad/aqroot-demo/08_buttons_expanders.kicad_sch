			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "BQ25185 STAT2 pull-up, FBV2-S1-008. Same 10 kOhm to +3V3 as R127 and the same SLUSF65A 1 k to 20 k window. STAT2 carries the fault distinction: STAT1 HIGH with STAT2 LOW is a fault, both HIGH is the combined charge-complete / sleep / charge-disabled state, so STAT1 alone would convey only fault/no-fault. STAT2 is also the pin that toggles continuously when no battery is present, so it is landed on an interrupt-capable PCAL input whose mask bit is SET by hardware default - the PCAL9535A powers up with 4Ah/4Bh = FFh - and firmware must leave it masked and poll. That is what let Ruling G reverse the earlier STAT1-only recommendation without importing a wake storm."
			(at 0 0 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
