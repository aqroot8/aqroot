				)
			)
		)
		(property "Tolerance" "1%"
			(at 0 0 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Power" "0.1W"
			(at 0 0 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "WAKE contact pull-up, FBV2-S1-009. 10 kOhm from the accessory side of the isolation gate to ACC_3V3_SW. It does two jobs. First it gives the contact a defined idle level so an absent or silent accessory does not float an exposed pin. Second it is what makes the pass gate work: with the source held near ACC_3V3_SW and the gate at ACC_3V3_SW, VGS is zero and the FET is off; the accessory pulling the contact down is what creates VGS and turns it on. IT MUST BE PULLED TO ACC_3V3_SW AND NOT TO +3V3 - a permanent pull-up would keep the contact live with the accessory rail off and would re-open B-08 from the other direction."
			(at 0 0 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
