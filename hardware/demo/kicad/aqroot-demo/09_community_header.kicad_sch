			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "External I2C series element, D-090, RE-DERIVED FOR THE TCA4307 AT FBV2-S1-009. 22 Ohm between the buffer's OUT pin and the contact. Delay is negligible - 22 Ohm into the 200 pF design-point bus is 4.4 ns against a 300 ns fast-mode rise-time budget - and the TCA4307 rise-time accelerator sources 2-5 mA through it, costing at most 110 mV. What it buys is that a short or an ESD strike at the contact is isolated from the pull-up node and from the buffer pin. RETAINED, and now justified against the buffer that is actually fitted."
			(at 0 0 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
