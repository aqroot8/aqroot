		(property "Description" "Special symbol for telling ERC where power comes from"
			(at 60.96 118.11 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "PROJECT GND DRIVER. KiCad ERC requires every net carrying `power_in` pins to see at least one `power_out`, and a GND power symbol is itself a `power_in`. This PWR_FLAG is what satisfies that for the WHOLE design - it was inherited on the Beta-DM sheet 09 as `#FLG0105` and is deliberately RE-CREATED here, with the same reference, because deleting it silently turns the entire GND net undriven. It is a schematic annotation with no footprint and no board presence."
			(at 0 0 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
