(page_layout
  (setup (textsize 1.5 1.5)(linewidth 0.15)(textlinewidth 0.15)
    (left_margin 10)(right_margin 10)(top_margin 10)(bottom_margin 32))
  (rect (start 0 0 ltcorner) (end 0 0) (linewidth 0.35))
  (rect (start 0 0) (end 180 27) (linewidth 0.35))
  (line (start 0 6.75) (end 180 6.75) (linewidth 0.20))
  (line (start 0 13.50) (end 180 13.50) (linewidth 0.20))
  (line (start 0 20.25) (end 180 20.25) (linewidth 0.20))
  (tbtext "AQROOT DEMO ASSEMBLY - ${ASSEMBLY_SIDE}" (pos 90 23.625)
    (font (linewidth 0.20) (size 2.8 2.8)) (justify center))
  (tbtext "RELEASE ${RELEASE} | BOARD SHA256 ${BOARD_SHA}" (pos 90 16.875)
    (font (linewidth 0.14) (size 1.55 1.55)) (justify center))
  (tbtext "VIEW RULE: TOP=FRONT/F.Cu NOT MIRRORED | BOTTOM=REAR/B.Cu MIRRORED AS ASSEMBLER SEES IT" (pos 90 10.125)
    (font (linewidth 0.12) (size 1.25 1.25)) (justify center))
  (tbtext "PIN-1/POLARITY: PAD NUMBERS + FAB MARKS AUTHORITATIVE; J1 PIN1 RIGHT FROM DISPLAY FRONT; J5 PIN1 TOP OF ROW | J4 LEADS <=0.80 mm BEFORE DISPLAY; D1/U6 FORM+TRIM PER NORMATIVE ASSEMBLY DOCS" (pos 90 3.375)
    (font (linewidth 0.09) (size 0.95 0.95)) (justify center))
)
