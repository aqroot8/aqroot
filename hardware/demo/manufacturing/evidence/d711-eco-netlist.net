		(comp
			(ref "U18")
			(value "LTC4368-1")
			(footprint "Package_SO:MSOP-10_3x3mm_P0.5mm")
			(fields
				(field
					(name "Note_Sourcing") "SOURCING D-615 PACKAGE CORRECTION. The board land is Package_SO:MSOP-10_3x3mm_P0.5mm and D-099 locked LTC4368IMS-1#PBF, MSOP-10, under FBV2-PWR-002 -- every safety-critical part leaded and inspectable, NO BOTTOM-TERMINATED PARTS. The schematic carried LTC4368IDD-1#PBF: the DD order code is DFN-10, confirmed live on the JLCPCB catalogue as DFN-10-EP(3x3) at 0.75 mm body height against MSOP-10 at 1.1 mm. LTC4368IMS-1#PBF (C688400) is stock 0; #TRPBF is the TAPE-AND-REEL order code of the same MSOP-10, I-grade (-40..+85 C), -1 device -- an order-code change of the identical part, D-210's precedent exactly, NOT an electrical change. Live record read 2026-09-05, LCSC C688401, stock 3; LTC4368HMS-1#PBF (C688391, MSOP-10, -1, H grade, stock 2) is the same-land alternate. U18 remains a CONSIGNED part per D-206.")
				(field
					(name "Note2") "SUPERSEDED BY D-615 -- the part this note prices is the DD order code, which is DFN-10, against an MSOP-10 land; kept as the historical record.  SOURCING 2026-08-23 (FBV2-S2-002) (B-71) - FIRST-BUILD BLOCKER. LTC4368IDD-1#PBF is LCSC C688397 with STOCK 4 against a need of 5. Consign from a broadline distributor; MSOP-10 at 0.5 mm pitch stays machine-placed. LCSC/JLC library state verified live on 2026-08-23 through the JLCPCB parts API (D-096). Stock is a snapshot, not a guarantee.")
				(field
					(name "LCSC") "C688401")
				(field
					(name "Manufacturer") "Analog Devices")
				(field
					(name "MPN") "LTC4368IMS-1#TRPBF")
				(field
					(name "Footprint") "Package_SO:MSOP-10_3x3mm_P0.5mm")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
			)
			(libsource
				(lib "AQROOT_Beta")
				(part "LTC4368-1")
				(description "Analog Devices LTC4368-1: 2.5-60 V UV/OV and reverse-supply protection controller with bidirectional electronic circuit breaker. Drives back-to-back external N-channel MOSFETs. Forward sense threshold +50 mV, reverse -50 mV (-1 option). GATE charge pump 35 uA pull-up, up to 13.1 V enhancement, referenced to VOUT. 2.2 V VIN UVLO. Pin-selectable overcurrent auto-retry timer or latch-off. THE -1 SUFFIX IS LOAD-BEARING: the -2 trips at -3 mV and blocks normal charging.")
			)
			(property
				(name "Note_Sourcing")
				(value "SOURCING D-615 PACKAGE CORRECTION. The board land is Package_SO:MSOP-10_3x3mm_P0.5mm and D-099 locked LTC4368IMS-1#PBF, MSOP-10, under FBV2-PWR-002 -- every safety-critical part leaded and inspectable, NO BOTTOM-TERMINATED PARTS. The schematic carried LTC4368IDD-1#PBF: the DD order code is DFN-10, confirmed live on the JLCPCB catalogue as DFN-10-EP(3x3) at 0.75 mm body height against MSOP-10 at 1.1 mm. LTC4368IMS-1#PBF (C688400) is stock 0; #TRPBF is the TAPE-AND-REEL order code of the same MSOP-10, I-grade (-40..+85 C), -1 device -- an order-code change of the identical part, D-210's precedent exactly, NOT an electrical change. Live record read 2026-09-05, LCSC C688401, stock 3; LTC4368HMS-1#PBF (C688391, MSOP-10, -1, H grade, stock 2) is the same-land alternate. U18 remains a CONSIGNED part per D-206.")
