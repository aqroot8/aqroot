		(comp
			(ref "U4")
			(value "BMI270")
			(footprint "AQROOT_Beta:Bosch_LGA-14_2.5x3.0mm_P0.5mm_BMI270")
			(datasheet "https://www.bosch-sensortec.com/media/boschsensortec/downloads/datasheets/bst-bmi270-ds000.pdf")
			(description "6-axis IMU, I2C/SPI, 14-pin LGA, 2.5 x 3.0 mm")
			(fields
				(field
					(name "LCSC") "C2836813")
				(field
					(name "Manufacturer") "Bosch Sensortec")
				(field
					(name "MPN") "BMI270")
				(field
					(name "Note") "Verified against BST-BMI270-DS000-08 Rev 1.6 (March 2026) in FBV2-S1-005. I2C mode: pin 1 SDO to GND selects the default address 0x68 (0x69 with SDO to VDDIO); pin 12 CSB hard-wired to VDDIO, which Bosch explicitly recommends for I2C; pins 13/14 are SCL/SDA. Pins 2 ASDx and 3 ASCx are the unused secondary interface and are tied to VDDIO - Bosch states they may go to VDDIO or be left open and MUST NOT be tied to GND. Pins 9 INT2, 10 OCSB and 11 OSDO are unused and are left DNC exactly as Bosch instructs. C6 and C7 are the recommended 100 nF at pin 5 VDDIO and pin 8 VDD; one cap must be placed at each pin. VDD 1.71-3.6 V, VDDIO 1.2-3.6 V, no supply-sequencing constraint and no slew-rate constraint. INT1_IO_CTRL resets to 0x00, so INT1 is high-Z until firmware enables it; the pin is push-pull or open-drain by INT1_IO_CTRL.od and active high or low by .lvl. Output pads are specified at IOH/IOL under 2 mA with VOH at least 0.8 x VDDIO. FIFO 2048 bytes. Accel-only low-power mode down to 4 uA plus about 3 uA for advanced features; suspend 3.5 uA. The device has NO tap or double-tap feature; raise-to-wake is the wrist-wear-wakeup feature. Land pattern verified against datasheet section 8.3, measured from the drawing: side pads 0.475 x 0.25 at x = plus/minus 1.1625, end pads 0.25 x 0.475 at y = plus/minus 0.9125, 0.50 mm pitch, and the printed 0.925 / 0.675 / 0.475 / 0.25 dimensions all reproduce. Bosch order code 0 273 017 008.")
				(field
					(name "Footprint") "AQROOT_Beta:Bosch_LGA-14_2.5x3.0mm_P0.5mm_BMI270")
				(field
					(name "Datasheet") "https://www.bosch-sensortec.com/media/boschsensortec/downloads/datasheets/bst-bmi270-ds000.pdf")
				(field
					(name "Description") "6-axis IMU, I2C/SPI, 14-pin LGA, 2.5 x 3.0 mm")
			)
			(libsource
				(lib "AQROOT_Beta")
				(part "BMI270")
				(description "6-axis IMU, I2C/SPI, 14-pin LGA, 2.5 x 3.0 mm")
			)
