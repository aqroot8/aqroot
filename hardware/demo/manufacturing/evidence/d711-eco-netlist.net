		(comp
			(ref "D2")
			(value "TPD4E1B06DRLR")
			(footprint "Package_TO_SOT_SMD:SOT-563")
			(datasheet "https://www.ti.com/lit/ds/symlink/tpd4e1b06.pdf")
			(description "TI TPD4E1B06 4-channel ultra-low-leakage bidirectional ESD array, SOT-563")
			(fields
				(field
					(name "LCSC") "C1972953")
				(field
					(name "Manufacturer") "Texas Instruments")
				(field
					(name "MPN") "TPD4E1B06DRLR")
				(field
					(name "Note") "Low-capacitance ESD array on the exposed community contacts, D-090 and FBV2-S1-009. TI TPD4E1B06DRLR, SLVSBQ8E: 4-channel BI-DIRECTIONAL, IEC 61000-4-2 +/-12 kV CONTACT and +/-15 kV AIR-GAP - beyond level 4 - IEC 61000-4-5 surge 3.0 A (8/20 us), I/O capacitance 0.7 pF TYPICAL and leakage 0.5 nA MAXIMUM. VRWM +/-5.5 V. Pinout 1 = IO1, 2 = GND, 3 = IO2, 4 = IO3, 5 = NC, 6 = IO4, DRL/SOT-563 1.6 x 1.6 mm. THESE ARRIVED FROM BETA-DM MARKED DNP AND ARE NOW FITTED: an unprotected user-accessible connector is not a defensible shipping state, and 0.7 pF costs nothing even on the 400 kHz I2C pair. THE 5.5 V VRWM IS WHY THIS PART IS NOT USED ON THE ACCESSORY 5 V RAIL - 5.0 V nominal leaves no working margin. The rails are protected instead by their own bulk capacitance and by the TPS22950C's ratings.")
				(field
					(name "Footprint") "Package_TO_SOT_SMD:SOT-563")
				(field
					(name "Datasheet") "https://www.ti.com/lit/ds/symlink/tpd4e1b06.pdf")
				(field
					(name "Description") "TI TPD4E1B06 4-channel ultra-low-leakage bidirectional ESD array, SOT-563")
			)
