		(comp
			(ref "U13")
			(value "TPS61023")
			(footprint "Package_TO_SOT_SMD:SOT-563")
			(datasheet "https://www.ti.com/lit/ds/symlink/tps61023.pdf")
			(description "3.7-A synchronous boost converter with 0.5-V ultra-low input voltage; 0.5-5.5 V input, adjustable 2.2-5.5 V output, 1-MHz switching, auto-PFM light-load mode, pass-through when VIN > VOUT and true input-to-output disconnect in shutdown; 6-pin SOT563 (DRL)")
			(fields
				(field
					(name "Note2") "DNP BY DESIGN AND CORRECTLY SO - documented 2026-08-23 (FBV2-S2-002). This part belongs to the NFC 5 V BOOST BRANCH: U13 TPS61023 + L2 1 uH + R44/R45 feedback divider + C34/C35 output, producing NFC_5V_PA_PENDING from BQ25185_SYS. The whole branch is DNP on the first build because D-055/D-056 select NFC_SUPPLY = +3V3 through R106 (FITTED), and R107 (DNP) is the mutually exclusive link that would select the 5 V branch instead. THE BRANCH IS PRESERVED, NOT ABANDONED: if bench measurement shows the 3.3 V field is short, fitting these six parts plus R107 and lifting R106 moves the PA to 5 V with no respin (D-049). NEVER FIT R106 AND R107 TOGETHER. Checked against the netlist at FBV2-S2-002; verified NOT to be an inherited Beta-DM oversight.")
				(field
					(name "LCSC") "C919459")
				(field
					(name "Manufacturer") "Texas Instruments")
				(field
					(name "MPN") "TPS61023DRLR")
				(field
					(name "Package") "DRL, 6-pin SOT-5X3 / SOT563, 1.2 mm x 1.6 mm, 0.5 mm pitch (JEDEC MO-293 variation UAAD); TI package drawing DRL0006A 4223266/F")
				(field
					(name "Footprint") "Package_TO_SOT_SMD:SOT-563")
				(field
					(name "Datasheet") "https://www.ti.com/lit/ds/symlink/tps61023.pdf")
				(field
					(name "Description") "3.7-A synchronous boost converter with 0.5-V ultra-low input voltage; 0.5-5.5 V input, adjustable 2.2-5.5 V output, 1-MHz switching, auto-PFM light-load mode, pass-through when VIN > VOUT and true input-to-output disconnect in shutdown; 6-pin SOT563 (DRL)")
			)
			(libsource
				(lib "AQROOT_Beta")
				(part "TPS61023")
				(description "3.7-A synchronous boost converter with 0.5-V ultra-low input voltage; 0.5-5.5 V input, adjustable 2.2-5.5 V output, 1-MHz switching, auto-PFM light-load mode, pass-through when VIN > VOUT and true input-to-output disconnect in shutdown; 6-pin SOT563 (DRL)")
			)
			(property
				(name "Note2")
				(value "DNP BY DESIGN AND CORRECTLY SO - documented 2026-08-23 (FBV2-S2-002). This part belongs to the NFC 5 V BOOST BRANCH: U13 TPS61023 + L2 1 uH + R44/R45 feedback divider + C34/C35 output, producing NFC_5V_PA_PENDING from BQ25185_SYS. The whole branch is DNP on the first build because D-055/D-056 select NFC_SUPPLY = +3V3 through R106 (FITTED), and R107 (DNP) is the mutually exclusive link that would select the 5 V branch instead. THE BRANCH IS PRESERVED, NOT ABANDONED: if bench measurement shows the 3.3 V field is short, fitting these six parts plus R107 and lifting R106 moves the PA to 5 V with no respin (D-049). NEVER FIT R106 AND R107 TOGETHER. Checked against the netlist at FBV2-S2-002; verified NOT to be an inherited Beta-DM oversight.")
			)
