		(comp
			(ref "SW2")
			(value "UP")
			(footprint "Button_Switch_SMD:SW_SPST_PTS645Sx43SMTR92")
			(description "Push button switch, generic, two pins")
			(fields
				(field
					(name "Note2") "SOURCING 2026-08-23 (FBV2-S2-002) (B-71). Genuine C&K PTS645SM43SMTR92LFS is LCSC C221880, stock 8432. A loose keyword search returns G-Switch GT-TC089A-H043-L1 (C843623) instead - a DIFFERENT MANUFACTURER whose land pattern has not been checked against the C&K G-Type layout this footprint was built from. Seven buttons per board is 35 placements for the first five; do not let a search shortcut swap them. LCSC/JLC library state verified live on 2026-08-23 through the JLCPCB parts API (D-096). Stock is a snapshot, not a guarantee.")
				(field
					(name "LCSC") "C221880")
				(field
					(name "Manufacturer") "C&K / Littelfuse")
				(field
					(name "MPN") "PTS645SM43SMTR92LFS")
				(field
					(name "Package") "6.0 x 6.0 mm tactile switch, straight SMT gull-wing, 4 terminals")
				(field
					(name "Mounting") "BOARD_MOUNTED")
				(field
					(name "BOM_Status") "C&K / Littelfuse PTS645 family, 6 mm SMD, top-actuated. FINAL SUFFIX VERIFY AT BOM LOCK - 160gf TARGET, ~5mm ACTUATOR TARGET, ~0.25 mm travel and 100,000 operation class are the selection targets, not a quoted commercial suffix. FOOTPRINT LOCKED / BOM SUFFIX VERIFY.")
				(field
					(name "Footprint_Provenance") "Land pattern VERIFIED_VENDOR_EXACT against the C&K / Littelfuse PTS645 series datasheet (Revised VL 01/29/26), RECOMMENDED PCB LAYOUT / PCB LAYOUT panels. The drawing gives 9.5 outer-edge to outer-edge and 6.4 inner-edge to inner-edge in X, and 5.8 outer to 3.2 inner in Y, which yields pads 1.55 (X) x 1.30 (Y) on centres of +/-3.975 (X) and +/-2.25 (Y). KiCad Button_Switch_SMD:SW_SPST_PTS645Sx43SMTR92 implements 1.55 x 1.30 at (+/-3.98, +/-2.25) - exact on pad size and on the Y centre, with a 0.005 mm rounding on the X centre that is far inside any fabrication tolerance. The same land pattern is published for both the 4.3 mm SMT G Type and the 7.3 mm straight SMT variants, which is why the footprint can be locked before the actuator-height suffix is. Four physical pads; C&K numbers them 1 and 2 on the top row and 3 and 4 on the bottom row with 1-2 tied and 3-4 tied, so the KiCad footprint maps its pad 1 to the top pair and pad 2 to the bottom pair, matching the 2-pin Switch:SW_Push symbol.")
				(field
					(name "Note") "User-facing button; receives an individual plastic cap. ENCLOSURE DESIGN TARGETS - these are AQROOT enclosure targets, NOT C&K switch specifications: individual plastic button caps, no membrane for Beta; 0.1-0.3 mm rest gap above the actuator with no preload; enclosure hard stop sized for ~0.3-0.4 mm total cap travel so the user cannot drive the tactile switch past its own travel.")
				(field
					(name "Footprint") "Button_Switch_SMD:SW_SPST_PTS645Sx43SMTR92")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Push button switch, generic, two pins")
			)
