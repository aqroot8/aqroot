			(footprint "Connector_JST:JST_PH_B2B-PH-K_1x02_P2.00mm_Vertical")
			(description "Generic connector, single row, 01x02, script generated (kicad-library-utils/schlib/autogen/connector/)")
			(fields
				(field
					(name "Note2") "SOURCING 2026-08-23 (FBV2-S2-002) (B-71). J4 and J6 are the same JST PH 2-pin header but carried two different MPN strings - J4 the (LF)(SN) plating suffix, J6 the bare code. That was not cosmetic: the bare code is LCSC C20504437 with STOCK 0 while B2B-PH-K-S(LF)(SN) is C131337 with 378913 in stock. Both are now the stocked string. LCSC/JLC library state verified live on 2026-08-23 through the JLCPCB parts API (D-096). Stock is a snapshot, not a guarantee.")
				(field
					(name "LCSC") "C131337")
				(field
					(name "Manufacturer") "JST")
				(field
					(name "MPN") "B2B-PH-K-S(LF)(SN)")
				(field
					(name "Package") "JST PH series, 2 pin, 2.00 mm pitch, vertical through-hole board-side header")
				(field
					(name "Mounting") "BOARD_MOUNTED")
				(field
					(name "Note") "Board-side speaker connector, RETAINED in FBV2-S1-006. J6 pin 1 = SPK_P = MAX98357A OUTP, J6 pin 2 = SPK_N = MAX98357A OUTN; observe polarity when crimping - the AS02008MR-LW152-R lead is RED positive and BLACK negative, and the cone moves forward on a positive voltage at the positive terminal. Mating side: JST PHR-2 housing with SPH-002T-P0.5S crimp contacts. The speaker lead is UL1571 AWG #32 and the PH applicable wire range is AWG #32 to #24, so AWG #32 is at the small end of the range but inside it - confirm the crimp at first article. The speaker is therefore replaceable without soldering. R121 / R122 and C81 / C82 sit between U5 and J6 as the EMI recovery positions.")
				(field
					(name "Footprint") "Connector_JST:JST_PH_B2B-PH-K_1x02_P2.00mm_Vertical")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Generic connector, single row, 01x02, script generated (kicad-library-utils/schlib/autogen/connector/)")
			)
