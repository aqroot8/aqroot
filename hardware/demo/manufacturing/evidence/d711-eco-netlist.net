		(comp
			(ref "R127")
			(value "10k")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(fields
				(field
					(name "Manufacturer") "UNI-ROYAL(Uniroyal Elec)")
				(field
					(name "MPN") "0603WAF1002T5E")
				(field
					(name "LCSC") "C25804")
				(field
					(name "Note_Sourcing") "SOURCING D-614. EXACT_PRIOR from the beta-dm audit line '10k' (ACCEPTED); manufacturer derived from the UNI-ROYAL(Uniroyal Elec) part-number family and corroborated by the audit text; identical specification.")
				(field
					(name "Tolerance") "1%")
				(field
					(name "Power") "0.1W")
				(field
					(name "Note") "BQ25185 STAT1 pull-up, FBV2-S1-008. SLUSF65A Table 5-1: STAT1 and STAT2 are OPEN-DRAIN, pull-up resistor 1 kOhm to 20 kOhm, maximum pull-up rail 5 V, 20 mA sink, and either may be left floating if unused. 10 kOhm is inside that window and is chosen over the 20 kOhm of Ruling G for the same reason the button pull-ups are 10 kOhm and not the PCAL internal 100 kOhm: the expander input leaks up to 1 uA and the board will be handled, so a stiffer high is worth 0.33 mA - and that current only flows while the charger is actually holding the pin LOW. CHARGER STATE DECODE, SLUSF65A Table 7-2: STAT1 LOW = charging; STAT1 HIGH with STAT2 LOW = fault; both HIGH is ONE combined state covering charge complete, sleep and charge disabled. WITH NO BATTERY FITTED the device cycles the BAT-pin capacitor and STAT2 TOGGLES while STAT1 stays stable - which is why both pins are landed, and why firmware must leave the STAT2 interrupt mask bit SET and poll instead.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
			)
