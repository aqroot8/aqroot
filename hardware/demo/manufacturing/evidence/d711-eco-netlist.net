		(comp
			(ref "R112")
			(value "0R DNP")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(fields
				(field
					(name "Note2") "DNP BY DESIGN - documented 2026-08-23 (FBV2-S2-002). R112 is a 0 R link between the display module SDO (/03_SPI_A_DISPLAY_SD/DISP_SDO) and the shared /SPI_A_MISO bus. It is DNP so the display CANNOT drive the bus the microSD card also reads on; the display is written to, never read from, on the first build. Fitting it is a no-respin provision under D-049 for panel register read-back during bring-up, and it MUST NOT be fitted while MX-8 (microSD and display never transact simultaneously on SPI-A) is relied on for bus integrity. It had no note at all before FBV2-S2-002.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
			)
