		(comp
			(ref "C12")
			(value "22uF")
			(footprint "Capacitor_SMD:C_1210_3225Metric")
			(description "Unpolarized capacitor")
			(fields
				(field
					(name "Manufacturer") "Samsung Electro-Mechanics")
				(field
					(name "MPN") "CL32B226KAJNNNE")
				(field
					(name "LCSC") "C309062")
				(field
					(name "Note_Sourcing") "SOURCING D-615 LIVE_RECORD. JLCPCB record read 2026-09-05T00:59:59Z: expand library, stock 280611, land 1210, Capacitance 22uF; Temperature Coefficient X7R; Tolerance ±10%; Voltage Rating 25V. Gates: 2x operating and survives absolute; not a resistor.")
				(field
					(name "Voltage") "16V")
				(field
					(name "Dielectric") "X7R")
				(field
					(name "Package") "1210 (3225 metric)")
				(field
					(name "BOM_Class") "STANDARD_EIA_PASSIVE - multi-source, approved alternates, no premium single MPN. DC-bias derating to be validated at BOM lock.")
				(field
					(name "Note") "LOCAL IR RESERVOIR, re-derived in FBV2-S1-007. 4.7 uF -> 22 uF, 0805 -> 1210. The 38 kHz carrier draws 150 mA at about one third duty, so the capacitor must supply I x D x (1-D) x T = 0.15 x 0.333 x 0.667 x 26.3 us = 0.88 uC per carrier period. Ripple = 0.88 uC / C: 4.7 uF gives 218 mV, 10 uF gives 88 mV, 22 uF gives 40 mV, 47 uF gives 19 mV. The design target is to keep the carrier below about 1.5 percent of the rail, so 22 uF is the first-build value; the requirement is at least 15 uF EFFECTIVE at 3.3 V DC bias, which is why the part is specified X7R 16 V in 1210 rather than a heavily derated 6.3 V 0805. This capacitor protects the shared +3V3 rail. The IR RECEIVER is protected separately and far harder by R21/C11, which give 41 dB at 38 kHz - see the R21 note.")
				(field
					(name "Footprint") "Capacitor_SMD:C_1210_3225Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Unpolarized capacitor")
			)
