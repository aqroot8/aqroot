			(footprint "Resistor_SMD:R_0603_1608Metric")
			(fields
				(field
					(name "Manufacturer") "UNI-ROYAL(Uniroyal Elec)")
				(field
					(name "MPN") "0603WAF1000T5E")
				(field
					(name "LCSC") "C22775")
				(field
					(name "Note_Sourcing") "SOURCING D-614. EXACT_PRIOR from the beta-dm audit line '100R 1%' (REJECTED - JLC match wrong); manufacturer derived from the UNI-ROYAL(Uniroyal Elec) part-number family and corroborated by the audit text; tolerance 1.0% meets 1.0%.")
				(field
					(name "Tolerance") "1%")
				(field
					(name "Power") "0.1W")
				(field
					(name "Note") "Community XGPIO series protection, D-090. 100 Ohm between the exposed contact and the PCAL9535A `U3` port pin. It is a fault-current limiter, not a termination: at the PCAL 5.5 V absolute-maximum I/O rating a hostile 5 V applied to the contact is held to (5 - 3.3 - Vf)/100 = about 10 mA into the clamp, and an ESD event is handled by the TPD4E1B06 array before the resistor is reached. The 70 us-per-transition I2C latency of an expander pin makes the RC irrelevant: 100 Ohm into a 200 pF accessory is 20 ns.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
