		(comp
			(ref "L2")
			(value "1uH")
			(footprint "AQROOT_Beta:Wurth_WE-MAPI_4030_74438357010")
			(description "Inductor")
			(fields
				(field
					(name "Note") "Wurth datasheet for 74438357010 (WE-MAPI 4030): 1 uH +/-20%; RDC 11.6 mOhm typ / 13.5 max; Isat 6.2 A (10% drop) / 12.5 A (30%); IRP,40K 10.25 A max; fres 59 MHz. Body 4.1 x 4.1 mm +/-0.2, height 3.1 mm max. Marked with start-of-winding. **FBV2-S2-001: THE 'FOOTPRINT STILL BLOCKED' NOTE THAT USED TO SIT HERE IS STALE AND IS WITHDRAWN** - the land pattern was built from the same datasheet's 'Recommended Land Pattern' (rev 003.001, 2024-02-27) with the dimensions read off the drawing leader lines. **THIS PART IS DNP HERE** - it is the NFC 5 V fallback inductor (D-055/D-056) - **but the SAME MPN IS FITTED AS `L4` on the accessory 5 V boost, and its Isat of 6.2 A closes B-68**: the accessory boost peak inductor current is 2.19 A at the 0.86 A worst-high current limit with V_SYS at 3.0 V, so the margin is 2.8x on Isat and 4.7x on IRP.")
				(field
					(name "Package") "WE-LQS series shielded SMT power inductor - LOCKED. Footprint BLOCKED: needs the official Wurth recommended land pattern.")
				(field
					(name "Manufacturer") "Wurth Elektronik")
				(field
					(name "MPN") "74438357010")
				(field
					(name "Note2") "DNP BY DESIGN AND CORRECTLY SO - documented 2026-08-23 (FBV2-S2-002). This part belongs to the NFC 5 V BOOST BRANCH: U13 TPS61023 + L2 1 uH + R44/R45 feedback divider + C34/C35 output, producing NFC_5V_PA_PENDING from BQ25185_SYS. The whole branch is DNP on the first build because D-055/D-056 select NFC_SUPPLY = +3V3 through R106 (FITTED), and R107 (DNP) is the mutually exclusive link that would select the 5 V branch instead. THE BRANCH IS PRESERVED, NOT ABANDONED: if bench measurement shows the 3.3 V field is short, fitting these six parts plus R107 and lifting R106 moves the PA to 5 V with no respin (D-049). NEVER FIT R106 AND R107 TOGETHER. Checked against the netlist at FBV2-S2-002; verified NOT to be an inherited Beta-DM oversight.")
				(field
					(name "LCSC") "C5542269")
				(field
					(name "Footprint") "AQROOT_Beta:Wurth_WE-MAPI_4030_74438357010")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Inductor")
			)
			(libsource
				(lib "Device")
				(part "L")
				(description "Inductor")
			)
