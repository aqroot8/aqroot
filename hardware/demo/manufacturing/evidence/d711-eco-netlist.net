				(field
					(name "Manufacturer") "Texas Instruments")
				(field
					(name "MPN") "TPS63020DSJR")
				(field
					(name "Package") "14-pin VSON (DSJ), 3 mm x 4 mm, with exposed thermal pad - exact DSJ land pattern still requires package-drawing verification")
				(field
					(name "Note") "TI SLVS916I section 5 defines the DSJ package as 14 numbered pins plus ONE exposed thermal pad; TI gives PGND and the exposed thermal pad pin number '-' and states the exposed thermal pad is connected to PGND. Pin/pad 15 (PGND_EP) is the AQROOT/KiCad logical identifier for that unnumbered exposed PGND thermal pad; it is NOT a manufacturer package pin number. There is no pin 16 - an earlier model wrongly split the single thermal terminal into 15 PGND + 16 EP.")
			)
