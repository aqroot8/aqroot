		(comp
			(ref "R128")
			(value "10k")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(fields
				(field
					(name "Manufacturer") "UNI-ROYAL(Uniroyal Elec)")
				(field
					(name "MPN") "0603WAF1002T5E")
				(field
					(name "LCSC") "C25804")
				(field
					(name "Note_Sourcing") "SOURCING D-614. EXACT_PRIOR from the beta-dm audit line '10k' (ACCEPTED); manufacturer derived from the UNI-ROYAL(Uniroyal Elec) part-number family and corroborated by the audit text; identical specification.")
				(field
					(name "Tolerance") "1%")
				(field
					(name "Power") "0.1W")
				(field
					(name "Note") "BQ25185 STAT2 pull-up, FBV2-S1-008. Same 10 kOhm to +3V3 as R127 and the same SLUSF65A 1 k to 20 k window. STAT2 carries the fault distinction: STAT1 HIGH with STAT2 LOW is a fault, both HIGH is the combined charge-complete / sleep / charge-disabled state, so STAT1 alone would convey only fault/no-fault. STAT2 is also the pin that toggles continuously when no battery is present, so it is landed on an interrupt-capable PCAL input whose mask bit is SET by hardware default - the PCAL9535A powers up with 4Ah/4Bh = FFh - and firmware must leave it masked and poll. That is what let Ruling G reverse the earlier STAT1-only recommendation without importing a wake storm.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
			)
