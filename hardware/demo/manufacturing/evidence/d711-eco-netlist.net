		(comp
			(ref "U7")
			(value "E07-400M10S")
			(footprint "AQROOT_Beta:Ebyte_E07-400M10S")
			(datasheet "https://www.ebyte.com/product/1546.html")
			(description "Ebyte E07-400M10S CC1101 410-450MHz 10dBm SPI module, 22-pad castellated SMD")
			(fields
				(field
					(name "LCSC") "C2965513")
				(field
					(name "Manufacturer") "Ebyte (Chengdu Ebyte Electronic Technology)")
				(field
					(name "MPN") "E07-400M10S")
				(field
					(name "Package") "20.0 x 14.0 x 3.0 mm castellated module, 22 pads, 1.27 mm pitch with a 5.57 mm gap at the IPEX end, all dimensioned in Ebyte manual chapter 3. VCC 2.5-3.6 V, supplied from +3V3. Pin 16 is MISO multiplexed with GDO1. Pins 6, 7, 8, 10 and 13 are vendor NC. GDO2 (14) is intentionally left unconnected - the manual states it may be left unconnected with interrupt status obtained by SPI polling, and AQROOT allocates no GPIO for it. Antenna: module IPEX/u.FL with Taoglas FXP450.07.0100C; pin 21 ANT stamp hole present but NOT routed. RF DO NOT ROUTE until final RF review. Procurement: Beta units must ship with the IPEX connector populated.")
				(field
					(name "Footprint") "AQROOT_Beta:Ebyte_E07-400M10S")
				(field
