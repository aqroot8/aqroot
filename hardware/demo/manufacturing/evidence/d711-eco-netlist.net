		(comp
			(ref "R119")
			(value "0R DNP")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(fields
				(field
					(name "Note2") "DNP BY DESIGN - documented 2026-08-23 (FBV2-S2-002). R119 is the ALTERNATE-ADDRESS strap for the BMI270: it would pull BMI270_SDO_ADDR up to +3V3. R118 (FITTED, 0 R to GND) holds the strap LOW, so the IMU answers at 0x68, which is what I2C_ADDRESS_REGISTRY.md records. R118 and R119 ARE MUTUALLY EXCLUSIVE - fitting both shorts +3V3 to GND through two 0 R resistors. This pair is a no-respin address escape under D-049 in case of a future address collision. It had no note at all before FBV2-S2-002.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
			)
			(libsource
				(lib "Device")
				(part "R")
				(description "Resistor")
			)
			(property
				(name "Note2")
				(value "DNP BY DESIGN - documented 2026-08-23 (FBV2-S2-002). R119 is the ALTERNATE-ADDRESS strap for the BMI270: it would pull BMI270_SDO_ADDR up to +3V3. R118 (FITTED, 0 R to GND) holds the strap LOW, so the IMU answers at 0x68, which is what I2C_ADDRESS_REGISTRY.md records. R118 and R119 ARE MUTUALLY EXCLUSIVE - fitting both shorts +3V3 to GND through two 0 R resistors. This pair is a no-respin address escape under D-049 in case of a future address collision. It had no note at all before FBV2-S2-002.")
			)
