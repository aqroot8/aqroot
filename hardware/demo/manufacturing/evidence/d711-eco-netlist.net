		(comp
			(ref "SW9")
			(value "SW_SPDT")
			(footprint "Button_Switch_SMD:SW_SPDT_CK_JS102011SAQN")
			(description "Single Pole Single Throw (SPST) switch")
			(fields
				(field
					(name "Note") "SYMBOL CONFLICT RESOLVED (2026-08-07). This instance is now Switch:SW_SPDT with pins 1/2/3, matching the 3-terminal JS102011SAQN. Pole mapping VERIFIED 1:1 - KiCad pin 2 (name 'B') is the pole, sitting alone on the opposite side of the symbol body from throws 1 ('A') and 3 ('C'), and C&K terminal 2 is likewise the COMMON/POLE. Wiring as built: pin 2 = BQ25185_SYS (source), pin 1 = U12 EN + TP13, pin 3 = unused throw carrying a no_connect. Electrical intent is unchanged and still SPST-in-practice (VINA -> switch -> EN, never switching GND). Actuator direction and travel still require the enclosure mechanical review.")
				(field
					(name "Package") "Right-angle SMD SPDT slide switch, C&K JS series. FOOTPRINT VERIFIED against the C&K JS-series drawing (octopart mirror of the C&K/ITT datasheet), page 4 'RIGHT ANGLE SURFACE MOUNT / PCB MOUNT - HOLE LAYOUT' for JS102011SAQN. Verified exact: terminal pitch 2.5 TYP; two locating holes dia 0.9 with 6.8 span, i.e. x = +/-3.4; three SPDT lands; body 9.0 x 3.6 + 2.0. Documented delta: KiCad land is 1.25 wide vs the drawing's 1.2 TYP, a 0.025 mm per-side solder-fillet allowance. Mechanically critical features (hole diameter, hole span, pitch) match exactly. Contact rating 6 VDC 0.3 A, 5000 cycles. Pole mapping unchanged and previously verified 1:1: KiCad pin 2 = C&K terminal 2 = COMMON.")
				(field
					(name "Manufacturer") "C&K (Littelfuse)")
				(field
					(name "MPN") "JS102011SAQN")
				(field
					(name "LCSC") "C221660")
				(field
					(name "Footprint") "Button_Switch_SMD:SW_SPDT_CK_JS102011SAQN")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Single Pole Single Throw (SPST) switch")
			)
			(libsource
				(lib "Switch")
				(part "SW_SPDT")
				(description "Switch, single pole double throw")
			)
			(property
				(name "Note")
				(value "SYMBOL CONFLICT RESOLVED (2026-08-07). This instance is now Switch:SW_SPDT with pins 1/2/3, matching the 3-terminal JS102011SAQN. Pole mapping VERIFIED 1:1 - KiCad pin 2 (name 'B') is the pole, sitting alone on the opposite side of the symbol body from throws 1 ('A') and 3 ('C'), and C&K terminal 2 is likewise the COMMON/POLE. Wiring as built: pin 2 = BQ25185_SYS (source), pin 1 = U12 EN + TP13, pin 3 = unused throw carrying a no_connect. Electrical intent is unchanged and still SPST-in-practice (VINA -> switch -> EN, never switching GND). Actuator direction and travel still require the enclosure mechanical review.")
			)
			(property
				(name "Package")
				(value "Right-angle SMD SPDT slide switch, C&K JS series. FOOTPRINT VERIFIED against the C&K JS-series drawing (octopart mirror of the C&K/ITT datasheet), page 4 'RIGHT ANGLE SURFACE MOUNT / PCB MOUNT - HOLE LAYOUT' for JS102011SAQN. Verified exact: terminal pitch 2.5 TYP; two locating holes dia 0.9 with 6.8 span, i.e. x = +/-3.4; three SPDT lands; body 9.0 x 3.6 + 2.0. Documented delta: KiCad land is 1.25 wide vs the drawing's 1.2 TYP, a 0.025 mm per-side solder-fillet allowance. Mechanically critical features (hole diameter, hole span, pitch) match exactly. Contact rating 6 VDC 0.3 A, 5000 cycles. Pole mapping unchanged and previously verified 1:1: KiCad pin 2 = C&K terminal 2 = COMMON.")
			)
