				(field
					(name "Note_Sourcing") "SOURCING D-614. EXACT_PRIOR from the beta-dm audit line '1uF' (ACCEPTED); manufacturer derived from the Samsung Electro-Mechanics part-number family and corroborated by the audit text; identical specification.")
				(field
					(name "Voltage") "16V")
				(field
					(name "Dielectric") "X7R")
				(field
					(name "Package") "0603 (1608 metric)")
				(field
					(name "BOM_Class") "STANDARD_EIA_PASSIVE - multi-source, approved alternates, no premium single MPN.")
				(field
					(name "Note") "LOCAL CIN for U17 TPS61169. TI SNVSA40B section 7.5.1 requires the input capacitor close to the VIN pin and GND pin, and Recommended Operating Conditions give CI minimum 1 uF - so this part is 1 uF, not a 100 nF bypass, to satisfy that requirement literally. C43 4.7uF is the power-stage input capacitor and sits 9.39 mm from U17 pin 5 - correct for the C43->L3 power loop (2.37 mm) but too far to bypass VIN. Added 2026-08-11 during the Routing Pass 1 blocker correction. Place immediately beside U17 VIN/GND; NOT ROUTED in this pass.")
				(field
					(name "Footprint") "Capacitor_SMD:C_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Unpolarized capacitor")
			)
