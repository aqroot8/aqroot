			(ref "R121")
			(value "0R")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(description "Resistor")
			(fields
				(field
					(name "Manufacturer") "UNI-ROYAL(Uniroyal Elec)")
				(field
					(name "MPN") "0603WAF0000T5E")
				(field
					(name "LCSC") "C21189")
				(field
					(name "Note_Sourcing") "SOURCING D-614. EXACT_PRIOR from the beta-dm audit line '0R' (ACCEPTED); manufacturer derived from the UNI-ROYAL(Uniroyal Elec) part-number family and corroborated by the audit text; identical specification.")
				(field
					(name "Note") "EMI recovery position, FITTED 0 R for the first build so the speaker path is a plain wire. If conducted or radiated emissions from the filterless Class D output need taming, replace with a ferrite bead (600 R at 100 MHz class) and populate the matching shunt capacitor. The MAX98357A data sheet Figure 14 shows compliant emissions with 12 in of speaker cable and NO output filtering, and AQROOT wire is much shorter than that, so nothing is fitted by default.")
