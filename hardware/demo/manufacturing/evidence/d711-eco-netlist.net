		(comp
			(ref "R47")
			(value "22R 1%")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(fields
				(field
					(name "Manufacturer") "UNI-ROYAL(Uniroyal Elec)")
				(field
					(name "MPN") "0603WAF220JT5E")
				(field
					(name "LCSC") "C23345")
				(field
					(name "Note_Sourcing") "SOURCING D-614. EXACT_PRIOR from the beta-dm audit line '22R 1%' (REJECTED - JLC match wrong); manufacturer derived from the UNI-ROYAL(Uniroyal Elec) part-number family and corroborated by the audit text; tolerance 1.0% meets 1.0%.")
				(field
					(name "Tolerance") "1%")
				(field
					(name "Power") "0.1W")
				(field
					(name "Note") "External I2C series element, D-090, RE-DERIVED FOR THE TCA4307 AT FBV2-S1-009. 22 Ohm between the buffer's OUT pin and the contact. Delay is negligible - 22 Ohm into the 200 pF design-point bus is 4.4 ns against a 300 ns fast-mode rise-time budget - and the TCA4307 rise-time accelerator sources 2-5 mA through it, costing at most 110 mV. What it buys is that a short or an ESD strike at the contact is isolated from the pull-up node and from the buffer pin. RETAINED, and now justified against the buffer that is actually fitted.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
			)
