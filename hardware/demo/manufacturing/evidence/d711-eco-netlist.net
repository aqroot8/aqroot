		(comp
			(ref "R63")
			(value "10k 1%")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(fields
				(field
					(name "Manufacturer") "UNI-ROYAL(Uniroyal Elec)")
				(field
					(name "MPN") "0603WAF1002T5E")
				(field
					(name "LCSC") "C25804")
				(field
					(name "Note_Sourcing") "SOURCING D-614. EXACT_PRIOR from the beta-dm audit line '10k 1%' (REJECTED - JLC match wrong); manufacturer derived from the UNI-ROYAL(Uniroyal Elec) part-number family and corroborated by the audit text; tolerance 1.0% meets 1.0%.")
				(field
					(name "Tolerance") "1%")
				(field
					(name "Power") "0.1W")
				(field
					(name "Note") "WAKE contact pull-up, FBV2-S1-009. 10 kOhm from the accessory side of the isolation gate to ACC_3V3_SW. It does two jobs. First it gives the contact a defined idle level so an absent or silent accessory does not float an exposed pin. Second it is what makes the pass gate work: with the source held near ACC_3V3_SW and the gate at ACC_3V3_SW, VGS is zero and the FET is off; the accessory pulling the contact down is what creates VGS and turns it on. IT MUST BE PULLED TO ACC_3V3_SW AND NOT TO +3V3 - a permanent pull-up would keep the contact live with the accessory rail off and would re-open B-08 from the other direction.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
			)
