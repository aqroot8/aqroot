		(comp
			(ref "Q1")
			(value "AO3400A")
			(footprint "Package_TO_SOT_SMD:SOT-23")
			(description "N-MOSFET transistor, gate/source/drain")
			(fields
				(field
					(name "Note") "IR LED low-side driver, RETAINED after audit in FBV2-S1-007 against AOS document AO3400A Rev 3.1, July 2023. PINOUT VERIFICATION CLOSED: the datasheet SOT-23 top and bottom views show the lone pin as Drain and the paired pins as Gate then Source, i.e. 1 = G, 2 = S, 3 = D, which is exactly what Transistor_FET:Q_NMOS_GSD maps and what the existing wiring uses. VGS(th) 0.65 / 1.05 / 1.45 V, so it is fully enhanced by a 3.3 V gate. RDS(on) under 48 mOhm at VGS = 2.5 V, giving about 5 mV at 150 mA - negligible against the LED VF. ID 5.7 A and IDM 30 A, so the part is roughly 38 times over-specified for this job; it is kept because it is already in the design on sheet 01 and is a jellybean. Switching loss at 38 kHz is negligible: with R22 100 R and Ciss of a few hundred pF the edge is well under 100 ns, about 0.3 percent of the carrier period, and conduction loss is 0.15^2 x 0.036 = 0.8 mW. SAFE OFF STATE IS PROVEN, NOT ASSUMED: R23 100 k to GND with IGSS 100 nA maximum gives at most 10 mV on the gate, far below the 650 mV minimum threshold, so there is no IR emission during boot, reset, GPIO high-impedance or a firmware crash. FOOTPRINT: AOS publishes no recommended land pattern in this datasheet, so the industry-standard IPC SOT-23 pattern applies and Package_TO_SOT_SMD:SOT-23 is the IPC-7351 derived KiCad footprint. That makes it an ordinary FBV2-S2 footprint-audit item rather than a blocker.")
				(field
					(name "Package") "SOT-23-3, pin 1 = G, 2 = S, 3 = D (confirmed from the AOS datasheet)")
				(field
					(name "Manufacturer") "Alpha & Omega Semiconductor")
				(field
					(name "MPN") "AO3400A")
				(field
					(name "Footprint") "Package_TO_SOT_SMD:SOT-23")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "N-MOSFET transistor, gate/source/drain")
			)
			(libsource
				(lib "Transistor_FET")
				(part "Q_NMOS_GSD")
				(description "N-MOSFET transistor, gate/source/drain")
			)
			(property
				(name "Note")
				(value "IR LED low-side driver, RETAINED after audit in FBV2-S1-007 against AOS document AO3400A Rev 3.1, July 2023. PINOUT VERIFICATION CLOSED: the datasheet SOT-23 top and bottom views show the lone pin as Drain and the paired pins as Gate then Source, i.e. 1 = G, 2 = S, 3 = D, which is exactly what Transistor_FET:Q_NMOS_GSD maps and what the existing wiring uses. VGS(th) 0.65 / 1.05 / 1.45 V, so it is fully enhanced by a 3.3 V gate. RDS(on) under 48 mOhm at VGS = 2.5 V, giving about 5 mV at 150 mA - negligible against the LED VF. ID 5.7 A and IDM 30 A, so the part is roughly 38 times over-specified for this job; it is kept because it is already in the design on sheet 01 and is a jellybean. Switching loss at 38 kHz is negligible: with R22 100 R and Ciss of a few hundred pF the edge is well under 100 ns, about 0.3 percent of the carrier period, and conduction loss is 0.15^2 x 0.036 = 0.8 mW. SAFE OFF STATE IS PROVEN, NOT ASSUMED: R23 100 k to GND with IGSS 100 nA maximum gives at most 10 mV on the gate, far below the 650 mV minimum threshold, so there is no IR emission during boot, reset, GPIO high-impedance or a firmware crash. FOOTPRINT: AOS publishes no recommended land pattern in this datasheet, so the industry-standard IPC SOT-23 pattern applies and Package_TO_SOT_SMD:SOT-23 is the IPC-7351 derived KiCad footprint. That makes it an ordinary FBV2-S2 footprint-audit item rather than a blocker.")
			)
			(property
				(name "Package")
				(value "SOT-23-3, pin 1 = G, 2 = S, 3 = D (confirmed from the AOS datasheet)")
			)
