					(name "MPN") "0603WAF1003T5E")
				(field
					(name "LCSC") "C25803")
				(field
					(name "Note_Sourcing") "SOURCING D-614. EXACT_PRIOR from the beta-dm audit line '100k' (ACCEPTED); manufacturer derived from the UNI-ROYAL(Uniroyal Elec) part-number family and corroborated by the audit text; identical specification.")
				(field
					(name "Tolerance") "1%")
				(field
					(name "Power") "0.1W")
				(field
					(name "Note") "ACC_DETECT_N pull-up, FBV2-S1-008. D-085 locks the convention: the accessory asserts detect by shorting community-port pin 23 to the adjacent GND at pin 21 with ONE 0 Ohm link, and AQROOT provides the 100 kOhm pull-up to +3V3. The pull-up and the expander both run from +3V3, so DETECTION WORKS WITH BOTH ACCESSORY RAILS OFF - which is what makes MX-3 implementable (neither rail may be enabled unless ACC_DETECT_N is asserted) and what makes a flipped accessory passively safe: it cannot ground pin 23, so it never receives power. THE RESISTOR IS PLACED HERE, AT THE EXPANDER, rather than on sheet 09, so the input has a defined level before the connector sheet is migrated. SHEET 09 MUST NOT ADD A SECOND PULL-UP - it adds only the connector contact to this same net.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
			)
