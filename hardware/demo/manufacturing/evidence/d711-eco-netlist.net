		(comp
			(ref "R46")
			(value "10k 1%")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(fields
				(field
					(name "Manufacturer") "UNI-ROYAL(Uniroyal Elec)")
				(field
					(name "MPN") "0603WAF1002T5E")
				(field
					(name "LCSC") "C25804")
				(field
					(name "Note_Sourcing") "SOURCING D-614. EXACT_PRIOR from the beta-dm audit line '10k 1%' (REJECTED - JLC match wrong); manufacturer derived from the UNI-ROYAL(Uniroyal Elec) part-number family and corroborated by the audit text; tolerance 1.0% meets 1.0%.")
				(field
					(name "Tolerance") "1%")
				(field
					(name "Power") "0.1W")
				(field
					(name "Note") "TCA4307 READY pull-up, FBV2-S1-009. READY is an OPEN-DRAIN flag that is high only when EN is high AND the IN and OUT sides have actually been connected, so it is the single best bring-up observable on this sheet: it distinguishes `rail off`, `enabled but never connected` and `connected and healthy`. TI's own application circuit uses 10 kOhm, and the datasheet's UVLO characterisation is specified with READY = 10 k to VCC, so 10 k is the characterised value. IT IS PULLED TO THE TCA4307'S OWN VCC, ACC_3V3_SW, NOT TO +3V3 - pulling it to a permanently powered rail would push current into an unpowered device's pin and would defeat the powered-off high-impedance property that the whole isolation argument rests on. VOL 0.4 V max at 3 mA, leakage +/-1 uA, so 10 k reads as a clean logic level. IT DELIBERATELY DOES NOT CONSUME A PCAL PIN IN REV 1: it is brought out to TP44 and read with a probe. Note that while EN is low the datasheet warns current flows from VCC through the pulled-down READY pin - 0.33 mA here - but ACC_3V3_SW is OFF by default, so that costs nothing in the no-accessory state.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description")
				)
			)
			(libsource
				(lib "Device")
				(part "R")
				(description "Resistor")
			)
