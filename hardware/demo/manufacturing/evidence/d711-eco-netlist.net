		(comp
			(ref "J2")
			(value "Molex_5025700893")
			(footprint "AQROOT_Beta:Molex_5025700893")
			(description "Molex 5025700893 microSD card connector, push-push, with mechanical card detect")
			(fields
				(field
					(name "Manufacturer") "Molex")
				(field
					(name "MPN") "5025700893")
				(field
					(name "LCSC") "C429846")
				(field
					(name "Package") "Molex 5025700893 microSD push-push connector with independent mechanical card-detect switch. Pin 9 SHIELD is one logical pin on four physical shell lands. Pin 11 DETECT_LEVER is a second ground terminal per Molex Vss:GROUND. MECHANICAL CARD DETECT - ACTIVE LOW ON CARD INSERTION - NO BETA GPIO ALLOCATED - DO NOT ROUTE UNTIL PIN-MAP REVISION. CD/DAT3 (pin 2) is the SD data line used as SD_CS_N in SPI mode and is NOT the mechanical switch. DAT1/DAT2 unused in 1-bit mode.")
				(field
