		(comp
			(ref "R68")
			(value "0R DNP")
			(footprint "Resistor_SMD:R_0603_1608Metric")
			(description "Resistor")
			(fields
				(field
					(name "Note") "FBV2-S2-001: **DNP AND IT MUST STAY DNP. THIS IS NOT A TUNING OPTION.** `R68` is a 0 Ohm bypass ACROSS `SW9`, the hard power switch on the TPS63020 enable. Fitting it wires the unit permanently ON and DEFEATS THE ONE PROVISION THAT LETS A USER POWER DOWN A HUNG OR UNFLASHED BOARD - the architecture is explicit that `SW9` is not a GPIO for exactly that reason. It exists only as a bench provision for characterising the regulator with the switch removed from the loop. It arrived from Beta-DM with no note at all, which is why it is documented here rather than deleted.")
				(field
					(name "Footprint") "Resistor_SMD:R_0603_1608Metric")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Resistor")
			)
