  "instrument_built": {
    "clamp": "--join-island-width is clamped into the band .kicad_dru section 5 publishes for the class, [min, trunk]; the BARREL is not clamped, because the licence machinery is where its geometry is judged",
    "clause6": "every ISLAND_JOIN_<cluster>_<n> area the run draws is audited by the same clause 6 that audits POUR_BRIDGE and PAD_ESCAPE areas",
    "flags": [
      "--join-island-via DIA:DRILL",
      "--join-island-width NM"
    ],
    "maze3d": "join_islands(floors=..., licence=True) -- a jumper carrying even ONE unlicensed barrel is reverted WHOLE and reported NO_DRU_LICENCE"
  },
  "licence": {
    "areas": [
      "ISLAND_JOIN_C28_1_1",
      "ISLAND_JOIN_C28_1_2"
    ],
    "authored_before_the_run": "w/d689/apply_dru.py, committed with this decision; the area NAMES are a property of the cluster and the barrel's ordinal, so the rule text could be written before the router chose a coordinate",
    "geometry_mm": {
      "annular": 0.175,
      "hole_size": 0.3,
      "via_diameter": 0.65
    },
    "no_new_capability": "a 0.30 mm drill in a 0.65 mm pad is COARSER than the 0.20 mm process this file licenses by name in nine places, and D-595 already licenses a 0.30 mm drill by name for POUR_BRIDGE_R19_1",
    "rules": 6,
    "why": "only the 0.300 mm DRILL needs an exception, against section 8's POWER-class 0.40 mm hole_size minimum.  0.650 mm clears board setup's 0.500 mm min_via_diameter and 0.175 mm clears the unconditional 0.125 mm annular floor, and both are stated at the value laid."
  },
