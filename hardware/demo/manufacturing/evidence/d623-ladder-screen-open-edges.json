 "verdict_legend": {
  "CORRIDOR_WALL": "NO_PATH at every in-budget rung.  No route exists at <= 0.025 mm; bounded there, not proved impossible.",
  "ESCAPE_UNLOCKED_BY_PITCH_THEN_CORRIDOR_WALL": "the escape refusal gave way to a finer lattice and the wall became NO_PATH.  Refinement moved the wall.",
  "ESCAPE_WALL_INVARIANT": "NO_LEGAL_ESCAPE_* at EVERY in-budget rung.  The blocker is copper around the land, not the pitch.",
  "NO_LATTICE_AT_ANY_PITCH": "a requested land's best escape margin is <= 0, so no pitch launches it.  A ladder cannot answer this net.",
  "POUR_WALL": "a route IS found, and the pour-partition contract refuses it.  The wall is the copper the route would sever, not the search."
 },
 "what": "D-623 -- `--grid ladder` pointed at EVERY standing single-edge candidate on the promoted board, one net per run, no --promote.  This is the screen the ladder was built to make cheap: it separates a WALL from an UNASKED QUESTION for each net at a bounded cost."
}
