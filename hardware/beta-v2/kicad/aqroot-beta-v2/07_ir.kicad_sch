		(property "BOM_Class" "STANDARD_EIA_PASSIVE - multi-source, approved alternates, no premium single MPN"
			(at 175.26 92.71 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "IR LED CURRENT LIMIT, re-derived in FBV2-S1-007 for a 150 mA first-build peak on the regulated +3V3 rail. 18R -> 12R 1 percent 0805. VF of the TSAL6100 at 150 mA is about 1.50 V typical, interpolated between the datasheet 1.35 V at 100 mA and 2.2 V at 1 A; the AO3400A adds about 5 mV at RDS(on) under 48 mOhm with a 3.3 V gate. I = (3.3 - 1.50 - 0.005) / 12 = 150 mA. Worst case high, rail +2 percent and VF 1.35 and R -1 percent: 170 mA, which is 85 percent of the 200 mA IFM. Worst case low, rail -2 percent and VF 1.80 and R +1 percent: 118 mA. Dissipation: 0.27 W instantaneous, about 90 mW during a burst at one third carrier duty and about 30 mW averaged over an NEC frame, against a 125 mW 0805 rating. R123 is a DNP parallel trim position. Allowed combinations, all inside IFM: 12R alone 150 mA, 12R || 220R 158 mA, 12R || 100R 168 mA, 12R || 68R 176 mA, 12R || 47R 188 mA. NEVER GO BELOW 10 OHM TOTAL - that would exceed the repetitive rating."
			(at 175.26 92.71 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
