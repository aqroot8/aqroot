		(property "Note" "Board-side speaker connector, RETAINED in FBV2-S1-006. J6 pin 1 = SPK_P = MAX98357A OUTP, J6 pin 2 = SPK_N = MAX98357A OUTN; observe polarity when crimping - the AS02008MR-LW152-R lead is RED positive and BLACK negative, and the cone moves forward on a positive voltage at the positive terminal. Mating side: JST PHR-2 housing with SPH-002T-P0.5S crimp contacts. The speaker lead is UL1571 AWG #32 and the PH applicable wire range is AWG #32 to #24, so AWG #32 is at the small end of the range but inside it - confirm the crimp at first article. The speaker is therefore replaceable without soldering. R121 / R122 and C81 / C82 sit between U5 and J6 as the EMI recovery positions."
			(at 241.3 110.49 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(pin "1"
			(uuid "a4b8ed39-0295-401d-bca4-d8282dcb062e")
		)
		(pin "2"
			(uuid "f51e73aa-c92d-484e-9e5d-ab73793005a5")
		)
		(instances
			(project "aqroot-Beta-v2"
				(path "/8a0ad1ee-a49e-4cff-9a78-44823e373405/74cc17f2-e3bd-4f3f-b221-e9414b1e23ac"
					(reference "J6")
					(unit 1)
				)
			)
		)
	)
	(label "SPK_P"
