		)
		(property "Package" "OFF_BOARD wired speaker, 20 mm diameter x 3 mm, 152 mm flying leads"
			(at 247.65 140.97 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Mounting" "OFF_BOARD"
			(at 247.65 140.97 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "OFF-BOARD, ENCLOSURE-MOUNTED, WIRED THROUGH J6. LS1 is drawn beyond the connector and is excluded from the board (on_board no); it carries no PCB footprint by design. LOCKED FBV2-S1-006 to PUI Audio AS02008MR-LW152-R, verified verbatim from the PUI drawing: 20 +/-0.2 mm diameter, 3 +/-0.2 mm deep, 8 ohm +/-15 %, 0.5 W rated and 0.8 W maximum, 86 +/-3 dBA at 0.1 W / 0.1 m, resonance 500 Hz +/-20 %, response 500 to 4000 Hz, 5 % maximum distortion, metal housing, Mylar cone, Nd-Fe-B magnet, 2.4 g, -20 to +55 C, RoHS. Leads are 152 +/-10 mm of UL1571 AWG #32, RED positive and BLACK negative, which crimp directly into JST PH SPH-002T-P0.5S contacts in a PHR-2 housing - AWG #32 is the small end of the PH applicable wire range, so the speaker is replaceable without soldering. The 500 to 4000 Hz response is a voice-band speaker chosen on purpose: intelligible speech, alerts and UI sounds, not music. The Nd-Fe-B magnet must stay clear of the NFC antenna zone."
			(at 247.65 140.97 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
